<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Zero_Blog::blog" title="Blog" translate="title" sortOrder="15">
                        <resource id="Zero_Blog::posts" title="Posts" translate="title" sortOrder="10"/>
                        <resource id="Zero_Blog::categories" title="Categories" translate="title" sortOrder="20"/>
                        <resource id="Zero_Blog::tags" title="Tags" translate="title" sortOrder="30"/>
                        <resource id="Zero_Blog::authors" title="Authors" translate="title" sortOrder="40"/>
                        <resource id="Zero_Blog::comments" title="Comments" translate="title" sortOrder="50"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Zero_Blog::config" title="Zero Blog" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
