    </virtualType>
    <virtualType name="Zero\Blog\Block\Adminhtml\Edit\AuthorDeleteButton" type="Zero\Blog\Block\Adminhtml\Edit\Button">
        <arguments>
            <argument name="kind" xsi:type="string">delete</argument>
            <argument name="entity" xsi:type="string">author</argument>
