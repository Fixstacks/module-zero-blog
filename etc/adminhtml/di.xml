            <argument name="entity" xsi:type="string">tag</argument>
        </arguments>
    </virtualType>
    <virtualType name="Zero\Blog\Block\Adminhtml\Edit\TagDeleteButton" type="Zero\Blog\Block\Adminhtml\Edit\Button">
        <arguments>
            <argument name="kind" xsi:type="string">delete</argument>
            <argument name="entity" xsi:type="string">tag</argument>
