    A post: header, featured image, table of contents, body (Zero CMS),
    tags, share links, author, products, related posts, comments.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="zero_blog_page"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="zero.blog.post" template="Zero_Blog::post.phtml">
                <arguments>
                    <argument name="view" xsi:type="object">Zero\Blog\ViewModel\Blog</argument>
                </arguments>
                <block class="Magento\Framework\View\Element\Template" name="zero.blog.post.card" as="card" template="Zero_Blog::post/card.phtml">
                    <arguments>
                        <argument name="view" xsi:type="object">Zero\Blog\ViewModel\Blog</argument>
                    </arguments>
                </block>
                <block class="Magento\Framework\View\Element\Template" name="zero.blog.post.comments" as="comments" template="Zero_Blog::post/comments.phtml">
                    <block class="Zero\Core\Block\Captcha\Field" name="zero.blog.post.comments.captcha" as="captcha">
                        <arguments>
                            <argument name="form_id" xsi:type="string">zero_blog_comment</argument>
                        </arguments>
                    </block>
                    <arguments>
                        <argument name="view" xsi:type="object">Zero\Blog\ViewModel\Blog</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
