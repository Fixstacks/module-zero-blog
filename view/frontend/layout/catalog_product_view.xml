    "From the blog" on product pages: posts linked to the product.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content.aside">
            <block class="Zero\Blog\Block\ProductPosts" name="zero.blog.product.posts" template="Zero_Blog::product/posts.phtml" before="-">
                <arguments>
                    <argument name="view" xsi:type="object">Zero\Blog\ViewModel\Blog</argument>
                </arguments>
                <block class="Magento\Framework\View\Element\Template" name="zero.blog.product.card" as="card" template="Zero_Blog::post/card.phtml">
                    <arguments>
                        <argument name="view" xsi:type="object">Zero\Blog\ViewModel\Blog</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
