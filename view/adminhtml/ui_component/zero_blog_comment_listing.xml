<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">zero_blog_comment_listing.zero_blog_comment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>zero_blog_comment_listing_columns</spinner>
        <deps>
            <dep>zero_blog_comment_listing.zero_blog_comment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="zero_blog_comment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">comment_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Zero_Blog::comments</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="zero_blog_comment_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>comment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="approve">
                <settings>
                    <url path="zero_blog/comment/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>approve</type>
                    <label translate="true">Approve</label>
                </settings>
            </action>
            <action name="reject">
                <settings>
                    <url path="zero_blog/comment/massStatus">
                        <param name="status">2</param>
                    </url>
                    <type>reject</type>
                    <label translate="true">Reject</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected records for good?</message>
                        <title translate="true">Delete</title>
                    </confirm>
                    <url path="zero_blog/comment/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="zero_blog_comment_listing_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="comment_id">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="post_title">
            <settings>
                <filter>text</filter>
                <label translate="true">Post</label>
            </settings>
        </column>
        <column name="author_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="author_email">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>
        <column name="content">
            <settings>
                <filter>text</filter>
                <label translate="true">Comment</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Zero\Blog\Model\Source\CommentStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Zero\Blog\Ui\Component\Listing\Column\Actions">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
