<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">zero_blog_author_listing.zero_blog_author_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Author</label>
            </button>
        </buttons>
        <spinner>zero_blog_author_listing_columns</spinner>
        <deps>
            <dep>zero_blog_author_listing.zero_blog_author_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="zero_blog_author_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">author_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Zero_Blog::authors</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="zero_blog_author_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>author_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected records for good?</message>
                        <title translate="true">Delete</title>
                    </confirm>
                    <url path="zero_blog/author/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="zero_blog_author_listing_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>author_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="author_id">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="name">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="url_key">
            <settings>
                <filter>text</filter>
                <label translate="true">URL Key</label>
            </settings>
        </column>
        <column name="job_title">
            <settings>
                <filter>text</filter>
                <label translate="true">Job Title</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Enabled</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Zero\Blog\Ui\Component\Listing\Column\Actions">
            <settings>
                <indexField>author_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
