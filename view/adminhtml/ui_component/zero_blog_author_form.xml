<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">zero_blog_author_form.zero_blog_author_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Author</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Zero\Blog\Block\Adminhtml\Edit\AuthorBackButton"/>
            <button name="delete" class="Zero\Blog\Block\Adminhtml\Edit\AuthorDeleteButton"/>
            <button name="save" class="Zero\Blog\Block\Adminhtml\Edit\AuthorSaveButton"/>
            <button name="continue" class="Zero\Blog\Block\Adminhtml\Edit\AuthorContinueButton"/>
        </buttons>
        <namespace>zero_blog_author_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>zero_blog_author_form.zero_blog_author_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="zero_blog_author_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="zero_blog/author/save"/>
        </settings>
        <dataProvider class="Zero\Blog\Ui\DataProvider\AuthorForm" name="zero_blog_author_form_data_source">
            <settings>
                <requestFieldName>author_id</requestFieldName>
                <primaryFieldName>author_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label/>
        </settings>
        <field name="author_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>author_id</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" sortOrder="20" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
            </settings>
        </field>
        <field name="url_key" sortOrder="30" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <notice translate="true">Empty: made from the name.</notice>
                <dataScope>url_key</dataScope>
            </settings>
        </field>
        <field name="job_title" sortOrder="40" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Job Title</label>
                <dataScope>job_title</dataScope>
            </settings>
        </field>
        <field name="bio" sortOrder="50" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Bio</label>
                <notice translate="true">A few sentences about the author: on their page and under their posts.</notice>
                <dataScope>bio</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>5</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="image" sortOrder="60" formElement="imageUploader">
            <settings>
                <label translate="true">Photo</label>
                <notice translate="true">Square, at least 200 px.</notice>
                <componentType>imageUploader</componentType>
                <dataScope>image</dataScope>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg png gif</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">zero_blog/image/upload</param>
                        </uploaderConfig>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="links" sortOrder="20">
        <settings>
            <label translate="true">Profiles</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="website" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Website</label>
                <notice translate="true">https://...</notice>
                <dataScope>website</dataScope>
            </settings>
        </field>
        <field name="linkedin" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">LinkedIn</label>
                <notice translate="true">https://www.linkedin.com/in/...</notice>
                <dataScope>linkedin</dataScope>
            </settings>
        </field>
        <field name="twitter" sortOrder="30" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">X</label>
                <notice translate="true">https://x.com/...</notice>
                <dataScope>twitter</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="30">
        <settings>
            <label translate="true">Search Engine Optimization</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="meta_title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <notice translate="true">Empty: the title.</notice>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_description" sortOrder="20" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <notice translate="true">About 150 characters. Empty: the excerpt or description.</notice>
                <dataScope>meta_description</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>3</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
    </fieldset>
</form>
